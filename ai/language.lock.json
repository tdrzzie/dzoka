  "configuration": {
    "ATTRIBUTES": {
      "input": "TEXT_UTF8",
      "language": "en",
      "questions": {
        "category": "What item was lost or found?",
        "brand": "What is the brand of the item?",
        "colour": "What colour is the item?",
        "location": "Where was the item lost or found?",
        "time": "When was the item lost or found?"
      },
      "prompt": "{question}",
      "maxInputTokens": 256,
      "truncation": "only-second",
      "maxSpanTokens": 16,
      "nullMargin": 0,
      "grounding": "unique-word-span-utf16-v1",
      "colours": [
        "beige",
        "black",
        "blue",
        "brown",
        "cream",
        "gold",
        "gray",
        "green",
        "grey",
        "navy",
        "orange",
        "pink",
        "purple",
        "red",
        "silver",
        "white",
        "yellow"
      ],
      "colourModifiers": [
        "bright",
        "dark",
        "light",
        "metallic",
        "off",
        "pale"
      ],
      "temporalPattern": "\\b(?:morning|afternoon|evening|night|noon|midnight|today|yesterday|tomorrow|week|month|year|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b",
      "output": "qa-source-spans-v1",
      "locationPattern": "\\b(?:at|in|near|inside|outside|by|from|around)\\s+(?:(?:the|a|an)\\s+)?",
      "timeQualifierPattern": "\\b(?:around|about|approximately|roughly|before|after|between)\\s+$",
      "timeUncertainty": "UNINTERPRETED",
      "padding": "none"
    },
    "TRANSLATION": {
      "input": "TEXT_UTF8",
      "sourceLanguage": "fr",
      "targetLanguage": "en",
      "prompt": "{source}",
      "maxInputTokens": 256,
      "maxOutputTokens": 64,
      "decoding": "full-prefix-greedy-cache-disabled-pad-suppressed-v1",
      "output": "opus-fr-en-greedy-v1",
      "padding": "none"
    },
    "RERANK": {
      "input": "RERANK_JSON",
      "language": "en",
      "maxCandidates": 8,
      "maxCandidateCharacters": 512,
      "maxInputTokens": 512,
      "output": "raw-logit-descending-client-id-tie-v1",
      "padding": "none"
    }
  }
