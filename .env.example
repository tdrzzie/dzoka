# Documentation template only; Spring reads the process environment, not this file automatically.
# Set secrets through your environment/secret manager. Empty values intentionally fail startup.
DZOKA_DB_URL=jdbc:postgresql://127.0.0.1:5432/dzoka
DZOKA_DB_USER=dzoka_app
DZOKA_DB_PASSWORD=
DZOKA_OIDC_ISSUER=
DZOKA_OIDC_JWK_SET_URI=
DZOKA_OIDC_AUDIENCE=dzoka-core
# Separate operational process only. Do not pass migration credentials to the API deployment.
DZOKA_MIGRATION_URL=
DZOKA_MIGRATION_USER=
DZOKA_MIGRATION_PASSWORD=
# Explicitly enable only after provisioning the documented private, never-versioned S3 bucket.
DZOKA_MEDIA_ENABLED=false
DZOKA_MEDIA_ENDPOINT=
DZOKA_MEDIA_REGION=
DZOKA_MEDIA_BUCKET=
DZOKA_MEDIA_ACCESS_KEY=
DZOKA_MEDIA_SECRET_KEY=
DZOKA_MEDIA_ALLOW_INSECURE_LOOPBACK=false
# Trusted operational worker identity; local tenant membership grants are provisioned separately.
DZOKA_WORKER_ISSUER=
DZOKA_WORKER_SUBJECT=
DZOKA_WORKER_TENANT=
DZOKA_WORKER_LIMIT=10
# Private Python consumer: pass through tools/ai_worker.py, which removes DB/S3 credentials.
DZOKA_AI_CORE_URL=
DZOKA_AI_TOKEN=
DZOKA_AI_TENANT=
DZOKA_AI_SPACE=
DZOKA_AI_MODEL_DIR=
DZOKA_AI_ALLOW_INSECURE_LOOPBACK=false
# Separate reviewed perception profile; no DB/S3 credentials enter this consumer.
DZOKA_AI_PROFILE=
DZOKA_AI_PERCEPTION_DIR=
